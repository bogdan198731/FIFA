SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/worldcup
DB_USERNAME=worldcup
DB_PASSWORD=worldcup

JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true

CORS_ALLOWED_ORIGINS=http://localhost:4200

# JWT — override in any environment that handles real users.
JWT_SECRET=dev-secret-change-me-this-must-be-at-least-32-bytes-long-please
JWT_EXPIRATION_MS=86400000

# API-Football key for the daily WC fixture sync (https://www.api-football.com).
# Optional for local dev — the sync endpoint returns an error if not set.
# Required in production for POST /api/admin/sync and the daily scheduled job.
API_FOOTBALL_KEY=
