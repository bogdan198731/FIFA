SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/worldcup
DB_USERNAME=worldcup
DB_PASSWORD=worldcup

JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true

CORS_ALLOWED_ORIGINS=http://localhost:4200

# JWT — override in any environment that handles real users.
JWT_SECRET=dev-secret-change-me-this-must-be-at-least-32-bytes-long-please
JWT_EXPIRATION_MS=86400000

# Live football data sync agent. Disabled by default. Set FOOTBALL_SYNC_ENABLED
# to true and supply FOOTBALL_API_KEY to pull teams/fixtures/scores from
# football-data.org (or whichever provider you configure).
FOOTBALL_SYNC_ENABLED=false
FOOTBALL_PROVIDER=football-data-org
FOOTBALL_API_KEY=
FOOTBALL_COMPETITION_ID=WC
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4
FOOTBALL_MATCH_INTERVAL=PT5M
FOOTBALL_TEAM_CRON=0 0 4 * * *
